# Environment Configuration Template for EV Market Analysis
# Copy this file to .env and configure your local credentials.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5001
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production

# MySQL Database Connection Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DB=ev_market_db

# Tableau Public / Tableau Server Embedded Dashboards
TABLEAU_DASHBOARD_URL=https://public.tableau.com/views/ElectricVehicleMarketAnalysis/EVMarketOverview
TABLEAU_STORY_URL=https://public.tableau.com/views/ElectricVehicleMarketAnalysis/EVMarketStory
